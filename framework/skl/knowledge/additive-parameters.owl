         xml:base="http://onto.brep.org/manufacturing/additive-parameters"
         xmlns="http://onto.brep.org/manufacturing/additive-parameters#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/additive-parameters">
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/additive-process"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/additive-materials"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#requiresParameterSet">
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/additive-process#Feature"/>
  <rdfs:range rdf:resource="#ParameterSet"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsParameterSet">
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/additive-process#Feature"/>
  <rdfs:range rdf:resource="#ParameterSet"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forOperation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSet"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-process#Operation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forMaterial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSet"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-materials#Material"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasNozzleTemp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPrintSpeed">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLayerHeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCoolingFan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFlowRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
