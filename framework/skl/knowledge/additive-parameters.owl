</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#hasNote"/>

<owl:Class rdf:about="#ParameterSet">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#PLA_Base_Params">
  <rdf:type rdf:resource="#ParameterSet"/>
  <forMaterial rdf:resource="http://onto.brep.org/manufacturing/additive-materials#PLA"/>
  <forOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#BaseDepositionOp"/>
  <hasNozzleTemp rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">210.0</hasNozzleTemp>
  <hasPrintSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</hasPrintSpeed>
  <hasLayerHeight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</hasLayerHeight>
  <hasCoolingFan rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</hasCoolingFan>
  <hasFlowRate rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</hasFlowRate>
  <hasRetraction rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</hasRetraction>
  <hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default set; common FDM practice; to be confirmed by trials or a cited source before P9</hasNote>
</owl:NamedIndividual>

