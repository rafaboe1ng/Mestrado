<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/operational-states"
         xmlns="http://onto.brep.org/manufacturing/operational-states#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/operational-states">
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/additive-machines"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/additive-process"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#instanceOfOperation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperationInstance"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-process#Operation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forFeature">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperationInstance"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-process#Feature"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#partOfJob">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperationInstance"/>
  <rdfs:range rdf:resource="#ManufacturingJob"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#observedDuring">
  <rdfs:domain rdf:resource="#OperationalState"/>
  <rdfs:range rdf:resource="#OperationInstance"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#observedOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperationalState"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-machines#Machine"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#observedInJob">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#OperationalState"/>
  <rdfs:range rdf:resource="#ManufacturingJob"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#transitionsTo">
  <rdfs:domain rdf:resource="#OperationalState"/>
  <rdfs:range rdf:resource="#OperationalState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evidencedBy">
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/additive-process#Feature"/>
  <rdfs:range rdf:resource="#OperationalState"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasStartTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasEndTime">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStateLabel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAnomalyScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAnomalyFlag">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasWindowCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMethodId">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMethodConfig">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#derivedFromSeries">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStepNumber">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasOverlapSeconds">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasJobId">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#OperationInstance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#OperationalState">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#StablePattern">
  <rdfs:subClassOf rdf:resource="#OperationalState"/>
</owl:Class>

<owl:Class rdf:about="#Transition">
  <rdfs:subClassOf rdf:resource="#OperationalState"/>
</owl:Class>

<owl:Class rdf:about="#Anomaly">
  <rdfs:subClassOf rdf:resource="#OperationalState"/>
</owl:Class>

<owl:Class rdf:about="#ManufacturingJob">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
