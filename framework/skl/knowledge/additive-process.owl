<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/additive-process"
         xmlns="http://onto.brep.org/manufacturing/additive-process#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/additive-process"/>

<owl:ObjectProperty rdf:about="#requiresOperation">
  <rdfs:domain rdf:resource="#Feature"/>
  <rdfs:range rdf:resource="#Operation"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasPrecedenceOrder">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#hasRuleSource"/>

<owl:AnnotationProperty rdf:about="#hasQualifierRule"/>

<owl:Class rdf:about="#Feature">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Base">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Wall">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#StandardWall">
  <rdfs:subClassOf rdf:resource="#Wall"/>
  <owl:disjointWith rdf:resource="#ThinWall"/>
</owl:Class>

<owl:Class rdf:about="#ThinWall">
  <rdfs:subClassOf rdf:resource="#Wall"/>
</owl:Class>

<owl:Class rdf:about="#Hole">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#StandardHole">
  <rdfs:subClassOf rdf:resource="#Hole"/>
  <owl:disjointWith rdf:resource="#SmallHole"/>
</owl:Class>

<owl:Class rdf:about="#SmallHole">
  <rdfs:subClassOf rdf:resource="#Hole"/>
</owl:Class>

<owl:Class rdf:about="#Rib">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#StandardRib">
  <rdfs:subClassOf rdf:resource="#Rib"/>
  <owl:disjointWith rdf:resource="#ThinRib"/>
</owl:Class>

<owl:Class rdf:about="#ThinRib">
  <rdfs:subClassOf rdf:resource="#Rib"/>
</owl:Class>

<owl:Class rdf:about="#Overhang">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#StandardOverhang">
  <rdfs:subClassOf rdf:resource="#Overhang"/>
  <owl:disjointWith rdf:resource="#SteepOverhang"/>
</owl:Class>

<owl:Class rdf:about="#SteepOverhang">
  <rdfs:subClassOf rdf:resource="#Overhang"/>
</owl:Class>

<owl:Class rdf:about="#GenericFeature">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#FeatureWithAnomalousDeposition">
  <rdfs:subClassOf rdf:resource="#Feature"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asserted by the sensor-driven process characterisation module when an anomalous operational state overlaps the operation instance that deposits the feature.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Operation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#DepositionOp">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#BaseDepositionOp">
  <rdf:type rdf:resource="#DepositionOp"/>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</hasPrecedenceOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#WallDepositionOp">
  <rdf:type rdf:resource="#DepositionOp"/>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</hasPrecedenceOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RibDepositionOp">
  <rdf:type rdf:resource="#DepositionOp"/>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</hasPrecedenceOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HoleDepositionOp">
  <rdf:type rdf:resource="#DepositionOp"/>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</hasPrecedenceOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#OverhangDepositionOp">
  <rdf:type rdf:resource="#DepositionOp"/>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</hasPrecedenceOrder>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Base"/>
    <rdf:Description rdf:about="#Wall"/>
    <rdf:Description rdf:about="#Hole"/>
    <rdf:Description rdf:about="#Rib"/>
    <rdf:Description rdf:about="#Overhang"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
