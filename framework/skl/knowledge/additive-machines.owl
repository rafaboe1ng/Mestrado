<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/additive-machines"
         xmlns="http://onto.brep.org/manufacturing/additive-machines#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/additive-machines">
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/additive-process"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#supportsOperation">
  <rdfs:domain rdf:resource="#Machine"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/additive-process#Operation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#printedOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/additive-process#Feature"/>
  <rdfs:range rdf:resource="#Machine"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasModel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMaxNozzleTemp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMinNozzleTemp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMaxPrintSpeed">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMaxLayerHeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMinLayerHeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMaxFlowRate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSafetyMaxRetraction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Machine">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FdmPrinter">
  <rdfs:subClassOf rdf:resource="#Machine"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#FdmPrinterLab">
  <rdf:type rdf:resource="#FdmPrinter"/>
  <supportsOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#BaseDepositionOp"/>
  <supportsOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#WallDepositionOp"/>
  <supportsOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#HoleDepositionOp"/>
  <supportsOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#RibDepositionOp"/>
  <supportsOperation rdf:resource="http://onto.brep.org/manufacturing/additive-process#OverhangDepositionOp"/>
  <hasModel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory FDM printer (to be named at collection)</hasModel>
  <hasSafetyMaxNozzleTemp rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">230.0</hasSafetyMaxNozzleTemp>
  <hasSafetyMinNozzleTemp rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">190.0</hasSafetyMinNozzleTemp>
  <hasSafetyMaxPrintSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</hasSafetyMaxPrintSpeed>
  <hasSafetyMaxLayerHeight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</hasSafetyMaxLayerHeight>
  <hasSafetyMinLayerHeight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</hasSafetyMinLayerHeight>
  <hasSafetyMaxFlowRate rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">115.0</hasSafetyMaxFlowRate>
  <hasSafetyMaxRetraction rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</hasSafetyMaxRetraction>
</owl:NamedIndividual>


</rdf:RDF>
